{
  "cliVersion": "1.0.0",
  "commands": {
    "query": { "status": "rest", "operations": ["rhdh:catalog/queryEntities"] },
    "get": { "status": "rest", "operations": ["rhdh:catalog/getEntityByName"] },
    "relations": { "status": "rest", "operations": ["rhdh:catalog/getEntityByName"] }
  },
  "operations": {
    "rhdh:catalog/queryEntities": {
      "method": "GET",
      "path": "/api/catalog/entities",
      "note": "Filtered entity listing; the response envelope is a JSON array."
    },
    "rhdh:catalog/getEntityByName": {
      "method": "GET",
      "path": "/api/catalog/entities/by-name/{kind}/{namespace}/{name}",
      "note": "Fetches one entity document including its relations."
    }
  }
}
